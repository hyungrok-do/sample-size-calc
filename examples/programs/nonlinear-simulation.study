-- Skewed outcomes and an estimated standard error: simulate the actual test.
-- This is the rejection probability of the specified z-threshold rule.
def effect : Real := 0.8
def critical : Real := normalQuantile(0.975)

def outcome (shift : Real) : Real :=
  let x := normal(0, 1)
  shift + 0.3*x + exp(normal(0, 0.6))

def reject (n : Nat) : Bool :=
  let control := sample(n, fun i => outcome(0))
  let treated := sample(n, fun i => outcome(effect))
  let se := sqrt(variance(control) / n + variance(treated) / n)
  abs(mean(treated) - mean(control)) / se > critical

def power (n : Nat) : Real := probability(reject(n))

simulation { replicates := 5000, seed := 2026, confidence := 0.95 }
solve for n : Nat in [10, 60] step 10
where power(n) >= 0.80
