import SSC
open SSC.Finite SSC.Derivation
open SSC.Calculation (emitEvaluation)
set_option maxRecDepth 10000
set_option maxHeartbeats 8000000

namespace DependentObservations

-- A participant's next binary observation depends on the preceding observation.
-- The state retains exactly what the transition and final test require.
abbrev State := Bool × Nat

def transition (afterFalse afterTrue : Rat)
    (h0 : 0 ≤ afterFalse ∧ afterFalse ≤ 1)
    (h1 : 0 ≤ afterTrue ∧ afterTrue ≤ 1) (s : State) : Program State :=
  let observation := if s.1 then Distribution.bernoulli afterTrue h1
    else Distribution.bernoulli afterFalse h0
  (Program.draw observation).map (fun x => (x, s.2 + if x then 1 else 0))

def nullModel (n : Nat) : Program State :=
  Program.iterate (transition (1/10) (7/10) (by decide +kernel) (by decide +kernel)) (false, 0) n

def alternativeModel (n : Nat) : Program State :=
  Program.iterate (transition (1/4) (4/5) (by decide +kernel) (by decide +kernel)) (false, 0) n

def upper (c : Nat) (s : State) : Bool := c ≤ s.2

def cutoff (n : Nat) : Nat :=
  let d := (derive (nullModel n)).distribution
  ((List.range (n+2)).find? (fun c => d.probability (upper c) ≤ 1/20)).getD (n+1)

def specification : Specification Nat State where
  null := nullModel
  alternative := alternativeModel
  reject := fun n => .test (upper (cutoff n))

-- This equality is generated by the generic compiler despite state dependence.
theorem derived_power (n : Nat) :
    (derive (alternativeModel n)).distribution.probability (upper (cutoff n)) =
      specification.power n := (derive (alternativeModel n)).probability_eq _

-- Independently calculated exact reference for a non-calibrated diagnostic event.
theorem dependent_probability : (nullModel 8).probability (upper 4) = 3560321/20000000 := by
  rw [← (derive (nullModel 8)).probability_eq (upper 4)]
  decide +kernel

#eval emitEvaluation (specification.evaluate 12)
#eval emitEvaluation (specification.evaluate 12
  { route := .simulation, replicates := 2000, seed := 41003 })

end DependentObservations
