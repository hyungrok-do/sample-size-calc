SSC_DOMAIN=lean.example.org
SSC_USERNAME=researcher
# Generate with: docker run --rm -it caddy:2.10.2-alpine caddy hash-password
# Single quotes preserve the dollar signs in Docker Compose's env-file parser.
SSC_PASSWORD_HASH='replace-with-generated-bcrypt-hash'
SSC_VERSION=local
SSC_MAX_JOBS=2
SSC_JOB_TIMEOUT=60
SSC_JOB_MEMORY_MB=2048
SSC_JOB_CPUS=2
# Optional: install a sandboxed OCI runtime on the host, then set its Docker name.
SSC_RUNTIME=
